{
  "name": "@icebreakers/eslint-config",
  "type": "module",
  "version": "8.0.0",
  "description": "ESLint preset from the repoctl development toolchain",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/repoctl.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "eslint-config",
    "icebreaker"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "import": "./dist/stylelint.js",
      "require": "./dist/stylelint.cjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "README.md",
    "README.zh.md",
    "dist",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "bench:formatters": "node --experimental-strip-types ./scripts/benchmark-formatters.ts",
    "test": "vitest run",
    "test:types": "tsd",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "sync": "cnpm sync @icebreakers/eslint-config",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint-plugin-pnpm": "^1.9.1",
    "tailwindcss": "^3.3.0 || ^4.1.17"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-pnpm": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@icebreakers/stylelint-config": "workspace:*",
    "@typescript-eslint/rule-tester": "^8.70.0",
    "@typescript-eslint/typescript-estree": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vue/compiler-sfc": "^3.5.43",
    "@weapp-vite/eslint": "^0.2.4",
    "defu": "^6.1.7",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "4.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "module": "nodenext",
      "baseUrl": ".",
      "paths": {
        "@icebreakers/stylelint-config": [
          "../stylelint/dist/index.d.ts"
        ],
        "eslint-plugin-better-stylelint": [
          "../eslint-plugin-better-stylelint/dist/index.d.ts"
        ]
      },
      "skipLibCheck": true
    }
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@types/semver": "catalog:",
    "@unocss/eslint-plugin": "66.10.5",
    "astro-eslint-parser": "^3.1.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-stylelint": "workspace:*",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "semver": "catalog:",
    "svelte": "^5.57.0",
    "svelte-eslint-parser": "^1.8.1"
  }
}
