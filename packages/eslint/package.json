{
  "name": "@icebreakers/eslint-config",
  "type": "module",
  "version": "8.0.23",
  "description": "ESLint preset from the repoctl development toolchain",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repo.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "eslint-config",
    "icebreaker"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stylelint": {
      "import": {
        "types": "./dist/stylelint.d.ts",
        "default": "./dist/stylelint.js"
      },
      "require": {
        "types": "./dist/stylelint.d.cts",
        "default": "./dist/stylelint.cjs"
      }
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "README.md",
    "README.zh.md",
    "dist",
    "index.d.ts"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "bench:formatters": "node --experimental-strip-types ./scripts/benchmark-formatters.ts",
    "test": "vitest run",
    "test:types": "tsd",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "sync": "repo release sync-npmmirror --package @icebreakers/eslint-config",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "*",
    "eslint-plugin-pnpm": "*",
    "tailwindcss": "*"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-pnpm": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@icebreakers/stylelint-config": "workspace:*",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript-eslint/rule-tester": "^8.74.0",
    "@typescript-eslint/typescript-estree": "^8.74.0",
    "@typescript-eslint/utils": "^8.74.0",
    "@typescript/typescript6": "catalog:",
    "@vue/compiler-sfc": "^3.5.46",
    "@weapp-vite/eslint": "^0.3.6",
    "defu": "catalog:",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-processor-vue-blocks": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "module": "nodenext",
      "baseUrl": ".",
      "paths": {
        "@icebreakers/stylelint-config": [
          "../stylelint/dist/index.d.ts"
        ],
        "eslint-plugin-better-stylelint": [
          "../eslint-plugin-better-stylelint/dist/index.d.ts"
        ]
      },
      "skipLibCheck": true
    }
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@types/semver": "catalog:",
    "@unocss/eslint-plugin": "66.13.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-stylelint": "workspace:*",
    "eslint-plugin-svelte": "^3.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "semver": "catalog:",
    "svelte": "^5.59.1",
    "svelte-eslint-parser": "^1.12.0"
  }
}
