{
  "name": "create-icebreaker",
  "type": "module",
  "version": "2.0.1",
  "description": "Compatibility create command for repoctl-managed workspaces",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "packages/create-icebreaker"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "monorepo",
    "create-app",
    "template",
    "scaffold"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "create-icebreaker": "bin/create-icebreaker.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "typecheck": "pnpm --filter create-repoctl build && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "create-repoctl": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
