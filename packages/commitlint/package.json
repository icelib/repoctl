{
  "name": "@icebreakers/commitlint-config",
  "type": "module",
  "version": "4.1.0",
  "description": "Commitlint preset from the repoctl development toolchain",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "packages/commitlint"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "commitlint",
    "repoctl",
    "icebreakers"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "README.zh.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build:watch": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "test:types": "tsd",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "skipLibCheck": true
    }
  },
  "peerDependencies": {
    "conventional-changelog-conventionalcommits": ">=10.4.0"
  },
  "peerDependenciesMeta": {
    "conventional-changelog-conventionalcommits": {
      "optional": false
    }
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "conventional-changelog-conventionalcommits": "^10.4.0"
  },
  "devDependencies": {
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2"
  }
}
