{
  "name": "@icebreakers/monorepo",
  "type": "module",
  "version": "5.7.1",
  "description": "Core engine and programmatic APIs for repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "packages/monorepo"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "monorepo",
    "repoctl",
    "tooling",
    "icebreaker"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./tooling": {
      "types": "./dist/tooling-entry.d.mts",
      "default": "./dist/tooling-entry.mjs"
    },
    "./tsconfig": "./tsconfig.base.json",
    "./tsconfig.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "repo": "bin/repo.js",
    "repoctl": "bin/repoctl.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist",
    "resources",
    "tsconfig.base.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "typecheck": "pnpm --filter @icebreakers/monorepo-templates build && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@commitlint/cli": "catalog:",
    "eslint": "^9.0.0 || ^10.0.0",
    "stylelint": "catalog:",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@babel/parser": "^7.29.9",
    "@icebreakers/commitlint-config": "workspace:*",
    "@icebreakers/eslint-config": "workspace:*",
    "@icebreakers/monorepo-templates": "workspace:*",
    "@icebreakers/stylelint-config": "workspace:*",
    "@npmcli/config": "10.14.0",
    "@pnpm/find-workspace-dir": "^1000.1.5",
    "@pnpm/logger": "^1100.0.0",
    "@pnpm/types": "^1102.1.1",
    "@pnpm/worker": "^1100.4.8",
    "@pnpm/workspace.find-packages": "^1000.0.65",
    "@pnpm/workspace.read-manifest": "^1000.3.1",
    "c12": "^3.3.4",
    "commander": "catalog:",
    "comment-json": "catalog:",
    "consola": "^3.4.2",
    "cross-spawn": "^7.0.6",
    "esbuild": "catalog:",
    "git-url-parse": "^16.1.0",
    "json5": "^2.2.3",
    "klaw": "^4.1.0",
    "lint-staged": "^17.6.0",
    "micromatch": "^4.0.8",
    "node-diff3": "~3.2.1",
    "p-queue": "^9.3.3",
    "pacote": "21.5.1",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "publint": "0.3.25",
    "semver": "catalog:",
    "simple-git": "^3.36.0",
    "tar": "7.5.22",
    "tinyglobby": "^0.2.17",
    "validate-npm-package-name": "^7.0.2",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/klaw": "^3.0.8",
    "@types/micromatch": "^4.0.10",
    "@types/npmcli__config": "^6.0.4",
    "@types/pacote": "^11.1.8",
    "@types/semver": "catalog:",
    "@types/validate-npm-package-name": "^4.0.2",
    "ci-info": "^4.4.0",
    "fdir": "^6.5.0",
    "knip": "6.40.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
