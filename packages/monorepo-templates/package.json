{
  "name": "@icebreakers/monorepo-templates",
  "type": "module",
  "version": "2.0.2",
  "description": "Built-in project templates and managed workspace assets for repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "packages/monorepo-templates"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "monorepo",
    "template",
    "scaffold"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "assets",
    "assets-data.mjs",
    "dist",
    "template-data.mjs",
    "templates"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "tsd": "pnpm build && tsd --files test-d/**/*.test-d.ts",
    "sync:assets": "pnpm run build && node dist/cli.mjs",
    "prepack": "pnpm run build && node dist/cli.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@inquirer/checkbox": "^5.2.5",
    "@inquirer/input": "^5.1.6",
    "@inquirer/select": "^5.2.5",
    "commander": "catalog:",
    "nanoexec": "^1.1.0",
    "yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
