{
  "name": "@icebreakers/client",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Internal Vue and Cloudflare application template shipped with repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "templates/client"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "vue",
    "cloudflare",
    "template"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm cf-typegen && vite --host",
    "build": "pnpm cf-typegen && vue-tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "typecheck": "pnpm cf-typegen && vue-tsc -b"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tanstack/vue-query": "^5.103.2",
    "@tanstack/vue-query-devtools": "^6.2.4",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.39",
    "@trpc/client": "^11.19.0",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/server": "^11.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "consola": "^3.4.2",
    "hono": "^4.13.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.135.0",
    "zod": "^4.6.5"
  }
}
