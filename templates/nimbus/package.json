{
  "name": "@icebreakers/nimbus-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual Nimbus documentation starter",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:locales && astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/styles/**/*.css\" && nimbus-docs lint",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.17.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.17.3",
    "@emnapi/runtime": "^1.11.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-mdx": "^3.8.3",
    "pagefind": "^1.5.2",
    "repoctl": "workspace:*",
    "typescript": "^7.0.2"
  }
}
