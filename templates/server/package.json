{
  "name": "@icebreakers/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Internal server package template shipped with repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "templates/server"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "server",
    "hono",
    "template"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc-router.ts",
    "./config": "./src/config.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm cf-typegen && wrangler dev",
    "build": "pnpm cf-typegen && tsdown",
    "build:watch": "tsdown --watch --sourcemap",
    "node:build:watch": "pnpm build:watch",
    "node:build": "pnpm build",
    "node:dev": "node --watch --experimental-strip-types src/node-entry.ts",
    "node:start": "node dist/node-entry.mjs",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "typecheck": "pnpm cf-typegen && tsc -p tsconfig.json && tsc -p tsconfig.worker.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "consola": "^3.4.2",
    "hono": "^4.13.8",
    "tsdown": "0.23.0",
    "wrangler": "^4.135.0",
    "zod": "^4.6.5"
  }
}
