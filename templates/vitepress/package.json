{
  "name": "@icebreakers/website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation website for repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repo.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "templates/vitepress"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "documentation",
    "vitepress",
    "monorepo"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "vitepress dev",
    "check:locales": "node --experimental-strip-types scripts/check-locales.ts",
    "build": "pnpm run check:locales && vitepress build",
    "preview": "vitepress preview",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "mermaid": "^12.3.0",
    "repoctl": "workspace:*",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0",
    "vitest": "~5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0"
  }
}
