{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".vitepress/home/**/*.ts",
    ".vitepress/navigation/**/*.ts",
    ".vitepress/seo.ts",
    ".vitepress/theme/**/*.ts",
    ".vitepress/theme/**/*.vue",
    ".vitepress/env.d.ts",
    "scripts/**/*.ts",
    "why/examples/2.npm-basic-package/src/**/*.ts",
    "why/examples/3.npm-basic-package/src/**/*.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    ".vitepress/config.ts"
  ]
}
