{
  "name": "@icebreakers/next-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Next.js App Router and TypeScript application template shipped with repoctl",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~7.0.2",
    "vitest": "~5.1.0"
  }
}
