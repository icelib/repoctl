{
  "name": "@icebreakers/react-lib-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "React component library with explicit JavaScript, types and CSS exports",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["LICENSE", "README.md", "dist"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "typecheck": "tsc -b",
    "tsd": "tsd --files test-d/**/*.test-d.ts",
    "test": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsd": "^0.33.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "~5.0.3"
  }
}
