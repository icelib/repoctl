{
  "name": "@icebreakers/vue-lib-template",
  "type": "module",
  "version": "0.0.3",
  "private": true,
  "description": "Internal Vue library template shipped with repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://repoctl.icebreaker.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/repoctl.git",
    "directory": "templates/vue-lib"
  },
  "bugs": {
    "url": "https://github.com/icelib/repoctl/issues"
  },
  "keywords": [
    "repoctl",
    "vue",
    "library",
    "template"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -b",
    "tsd": "pnpm build && tsd --typings dist/index.d.ts --files test-d/**/*.test-d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.umd.cjs"
      },
      "./style.css": "./dist/index.css"
    },
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
